# Ignore everything
*

# EXCEPT keep DenseNet files & essential project files
!.gitignore
!requirements.txt
!README.md

# Keep DenseNet code
!densenet.py
!densenet.ipynb

# Ignore datasets and generated figures
BreakHis/
figures/

# Ignore model weights and artifacts
*.pth
*.npy
*.npz
*.joblib

# Ignore hybrid / resnet pipelines
resnet.py
resnet_Kaggle.ipynb
nlp.ipynb

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Ignore secrets / environment
.env
.env.*

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore any logs, temp, cache
*.log
*.tmp
__pycache__/
*.pyc
